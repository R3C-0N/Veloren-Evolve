ItemDef(
    legacy_name: "Wooden Pickaxe",
    legacy_description: "Barely a pickaxe, but it opens stone.",
    kind: Tool((
        kind: Pick,
        hands: Two,
        stats: (
            equip_time_secs: 0.35,
            power: 0.8,
            effect_power: 1.0,
            speed: 1.0,
            range: 1.0,
            energy_efficiency: 1.0,
            buff_strength: 1.0,
        ),
        // Un outil de creusement, pas une arme : il ne s'equipe qu'a son
        // emplacement d'outil, et le personnage l'y prend tout seul.
        usage: Creusement,
    )),
    quality: Low,
    tags: [
        CraftingTool,
        // Le grade de l'outil se lit ici, et nulle part ailleurs : la matiere
        // est le grade. Voir `common::creusement::grade_outil`.
        MaterialKind(Wood),
    ],
    ability_spec: None,
)
